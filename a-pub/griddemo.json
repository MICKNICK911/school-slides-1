        {
          "title": "PHONETIC SKILL 1",
          "subtitle": "ONE CONSONANT FOLLOWS THE VOWEL",
          "lessonNumber": 2,
          "locked": true,
          "worksheetEnabled": true,
          "worksheetCount": 1,
          "blocks": [
            {
              "id": "rh07",
              "row": 0,
