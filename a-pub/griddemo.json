              "text": "<p><span style=\"font-size:34px;color:#E2571C;\"><b>PHONETIC SKILL 5</b></span>&nbsp;&nbsp;<span style=\"font-size:14px;letter-spacing:1px;color:#868e96;\"><b>ADJACENT VOWELS</b></span></p>",
