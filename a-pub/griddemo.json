              "showBorder": false,
              "text": "<p><span style=\"font-size:34px;color:#1c7ed6;\"><b>DECODING SKILL 1</b></span>&nbsp;&nbsp;<span style=\"font-size:14px;letter-spacing:1px;color:#868e96;\"><b>ONE GUARDIAN CONSONANT</b></span></p>",
