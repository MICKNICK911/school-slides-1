              "showBorder": false,
              "text": "<p><span style=\"font-size:34px;color:#E2571C;\"><b>PHONETIC SKILL 4</b></span>&nbsp;&nbsp;<span style=\"font-size:14px;letter-spacing:1px;color:#868e96;\"><b>SILENT E MAKES FIRST VOWEL LONG</b></span></p>",
              "fontSize": 34,
              "color": "#1a1a1a",
