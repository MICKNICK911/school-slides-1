              "type": "text",
              "showBorder": false,
              "text": "<p><span style=\"font-size:34px;color:#E2571C;\"><b>PHONETIC SKILL 3</b></span>&nbsp;&nbsp;<span style=\"font-size:14px;letter-spacing:1px;color:#868e96;\"><b>VOWEL STANDS ALONE</b></span></p>",
              "fontSize": 34,
              "color": "#1a1a1a",
              "textAlign": "center",
              "verticalAlign": "center",
              "bold": false,
              "italic": false,
              "underline": false,
